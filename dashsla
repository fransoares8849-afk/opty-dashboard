function linReg(data){const n=data.length;if(n<2)return data.map(()=>data[0]||0);let sx=0,sy=0,sxy=0,sx2=0;data.forEach((y,x)=>{sx+=x;sy+=y;sxy+=x*y;sx2+=x*x;});const m=(n*sxy-sx*sy)/(n*sx2-sx*sx),b=(sy-m*sx)/n;return data.map((_,x)=>Math.round(Math.max(0,m*x+b)*10)/10);}

