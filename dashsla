<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Opty · Dashboard SLA</title>
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
<style>
:root{
  --dk:#0E2A55;--md:#1A5F9E;--lt:#2B9ED4;--cy:#2BB8D4;
  --wh:#fff;--bg:#F2F7FC;--g50:#F7F9FB;--g100:#EDF1F6;--g200:#D4DCE8;
  --g400:#8A9BB5;--g700:#3A4A62;--g900:#0F1E35;
  --gbg:#E8F5ED;--gtx:#1A6E3A;--abg:#FEF3E2;--atx:#9B5C0A;
  --rbg:#FDECEA;--rtx:#B52B2B;--bbg:#E3F2FD;--btx:#0D5FA0;
  --rsm:6px;--rmd:10px;--rlg:16px;
  --ssm:0 1px 4px rgba(14,42,85,.07);--smd:0 4px 18px rgba(14,42,85,.10);
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
body{font-family:'DM Sans',sans-serif;background:var(--bg);color:var(--g900);min-height:100vh}

/* TOPBAR */
.topbar{background:var(--dk);height:62px;padding:0 2rem;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:100;box-shadow:0 2px 20px rgba(14,42,85,.3)}
.tb-brand{display:flex;align-items:center;gap:18px}
.tb-sep{border-left:1px solid rgba(255,255,255,.18);padding-left:18px;display:flex;flex-direction:column;gap:2px}
.tb-title{font-family:'Sora',sans-serif;font-weight:600;font-size:15px;color:rgba(255,255,255,.92)}
.tb-sub{font-size:11px;color:rgba(255,255,255,.38)}
.tb-chips{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.chip{font-size:11px;font-weight:500;color:rgba(255,255,255,.55);background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.12);border-radius:99px;padding:4px 12px}
.chip.cy{color:var(--cy);border-color:rgba(43,184,212,.3);background:rgba(43,184,212,.08)}
.share-btn{display:flex;align-items:center;gap:6px;font-family:'DM Sans',sans-serif;font-size:12px;font-weight:500;color:#fff;background:var(--cy);border:none;border-radius:99px;padding:5px 14px;cursor:pointer;transition:background .15s}
.share-btn:hover{background:#1FA8C2}
.share-btn svg{width:13px;height:13px;stroke:#fff}

/* PAGE */
.page{max-width:1260px;margin:0 auto;padding:1.75rem 2rem 3rem}

/* FILTERS */
.filters-bar{display:flex;align-items:center;gap:10px;flex-wrap:wrap;background:var(--wh);border-radius:var(--rlg);padding:.8rem 1.1rem;border:1px solid var(--g100);box-shadow:var(--ssm);margin-bottom:1.5rem}
.fl{font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.07em;color:var(--g400);margin-right:2px}
.fs{font-family:'DM Sans',sans-serif;font-size:12px;font-weight:500;color:var(--g700);background:var(--g50);border:1px solid var(--g200);border-radius:var(--rsm);padding:5px 9px;cursor:pointer;outline:none}
.fs:focus{border-color:var(--cy)}
.fd{font-family:'DM Sans',sans-serif;font-size:12px;color:var(--g700);background:var(--g50);border:1px solid var(--g200);border-radius:var(--rsm);padding:5px 9px;outline:none}
.fsep{color:var(--g200);font-size:18px}
.btn-reset{margin-left:auto;font-family:'DM Sans',sans-serif;font-size:12px;font-weight:500;color:var(--g400);background:transparent;border:1px solid var(--g200);border-radius:var(--rsm);padding:5px 12px;cursor:pointer;transition:all .15s;display:flex;align-items:center;gap:5px}
.btn-reset:hover{color:var(--rtx);border-color:#F0A0A0;background:var(--rbg)}
.rc{font-size:11px;color:var(--g400);margin-left:2px}

/* SEC */
.sec{font-family:'Sora',sans-serif;font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:.1em;color:var(--md);margin-bottom:12px;display:flex;align-items:center;gap:8px}
.sec::after{content:'';flex:1;height:1px;background:var(--g200)}

/* METRICS */
.metrics{display:grid;grid-template-columns:repeat(7,1fr);gap:10px;margin-bottom:1.75rem}
.mc{background:var(--wh);border-radius:var(--rlg);padding:1rem 1.1rem;box-shadow:var(--ssm);border:1px solid var(--g100);position:relative;overflow:hidden;transition:box-shadow .2s,transform .2s}
.mc:hover{box-shadow:var(--smd);transform:translateY(-2px)}
.mc::before{content:'';position:absolute;top:0;left:0;right:0;height:3px}
.mc.total::before{background:var(--md)}.mc.tratado::before{background:#22A85A}
.mc.aberto::before{background:var(--lt)}.mc.andamento::before{background:#7C3AED}
.mc.fora::before{background:#E04444}.mc.pendente::before{background:#F59E0B}
.mc.duplicado::before{background:#6366F1}
.mc-icon{width:32px;height:32px;border-radius:var(--rmd);display:flex;align-items:center;justify-content:center;margin-bottom:9px}
.mc.total .mc-icon{background:#E3F0FF}.mc.tratado .mc-icon{background:var(--gbg)}
.mc.aberto .mc-icon{background:#E0F6FD}.mc.andamento .mc-icon{background:#EDE9FB}
.mc.fora .mc-icon{background:var(--rbg)}.mc.pendente .mc-icon{background:var(--abg)}
.mc.duplicado .mc-icon{background:#EEF2FF}
.mc-icon svg{width:16px;height:16px}
.mc.total .mc-icon svg{stroke:var(--md)}.mc.tratado .mc-icon svg{stroke:var(--gtx)}
.mc.aberto .mc-icon svg{stroke:#0B7BAC}.mc.andamento .mc-icon svg{stroke:#5B21B6}
.mc.fora .mc-icon svg{stroke:var(--rtx)}.mc.pendente .mc-icon svg{stroke:#D97706}
.mc.duplicado .mc-icon svg{stroke:#4F46E5}
.mc-val{font-family:'Sora',sans-serif;font-size:24px;font-weight:700;line-height:1;margin-bottom:2px;letter-spacing:-.03em}
.mc.total .mc-val{color:var(--dk)}.mc.tratado .mc-val{color:var(--gtx)}
.mc.aberto .mc-val{color:#0B7BAC}.mc.andamento .mc-val{color:#5B21B6}
.mc.fora .mc-val{color:var(--rtx)}.mc.pendente .mc-val{color:#B45309}
.mc.duplicado .mc-val{color:#4338CA}
.mc-lbl{font-size:11px;font-weight:500;color:var(--g400)}
.mc-sub{font-size:11px;color:var(--g700);margin-top:6px;padding-top:6px;border-top:1px solid var(--g100);line-height:1.7}
.mc-sub strong{color:var(--g700)}
.mc-progress{margin-top:8px;padding-top:8px;border-top:1px solid var(--g100)}

.mc-progress-lbl{font-size:10px;color:var(--g400);margin-bottom:4px;display:flex;justify-content:space-between}
.mc-progress-bar{background:var(--g100);border-radius:99px;height:5px;overflow:hidden}
.mc-progress-fill{height:100%;border-radius:99px;transition:width .6s}
.tratado-card{background:linear-gradient(135deg,#0E2A55,#1A5F9E)!important;border-color:#1A5F9E!important}
.tratado-card .mc-val{color:#fff!important}.tratado-card .mc-lbl{color:rgba(255,255,255,.65)!important}
.tratado-card .mc-sub{color:rgba(255,255,255,.55)!important;border-top-color:rgba(255,255,255,.15)!important}
.tratado-card .mc-sub strong{color:#fff!important}
.tratado-card .mc-progress{border-top-color:rgba(255,255,255,.15)!important}
.tratado-card .mc-progress-lbl{color:rgba(255,255,255,.55)!important}
.tratado-card .mc-progress-bar{background:rgba(255,255,255,.2)!important}
.tratado-card::before{background:var(--cy)!important}

/* CONV GRID */
.conv-grid{display:grid;gap:14px;margin-bottom:1.75rem}
.card{background:var(--wh);border-radius:var(--rlg);box-shadow:var(--ssm);border:1px solid var(--g100);overflow:hidden}
.card-head{padding:.8rem 1.2rem;display:flex;align-items:center;gap:8px;border-bottom:1px solid var(--g100);flex-wrap:wrap}
.card-body{padding:.9rem 1.2rem 1.1rem;overflow-x:auto}
.conv-badge{font-family:'Sora',sans-serif;font-size:11px;font-weight:600;padding:3px 9px;border-radius:99px;color:#fff;white-space:nowrap}
.card-title{font-size:12px;font-weight:500;color:var(--g700)}
table{width:100%;border-collapse:collapse;font-size:11.5px;min-width:700px}
thead th{font-size:10px;font-weight:600;text-transform:uppercase;letter-spacing:.05em;color:var(--g400);padding:0 5px 7px 0;text-align:left;border-bottom:1px solid var(--g100);white-space:nowrap}
thead th.r{text-align:right}
tbody td{padding:5px 5px 5px 0;border-bottom:1px solid var(--g100);color:var(--g700);vertical-align:middle}
tbody td.r{text-align:right}
tbody tr:last-child td{border-bottom:none;font-weight:600;color:var(--g900)}
.tipo-lbl{font-weight:500;color:var(--g900)}
.pill{display:inline-block;font-size:10px;font-weight:500;padding:2px 7px;border-radius:99px;white-space:nowrap}
.p-ok{background:var(--gbg);color:var(--gtx)}.p-warn{background:var(--abg);color:var(--atx)}
.p-blue{background:var(--bbg);color:var(--btx)}.p-red{background:var(--rbg);color:var(--rtx)}
.p-gray{background:var(--g100);color:var(--g400)}.p-purple{background:#EDE9FB;color:#4B3BAA}
.sla-row{margin-top:10px;padding-top:10px;border-top:1px solid var(--g100)}
.sla-lbl{font-size:11px;color:var(--g400);margin-bottom:3px}
.sla-val{font-size:12px;font-weight:600;margin-bottom:4px}
.sla-bar{background:var(--g100);border-radius:99px;height:5px;overflow:hidden}
.sla-fill{height:100%;border-radius:99px;transition:width .6s}

/* CHART */
.chart-card{background:var(--wh);border-radius:var(--rlg);box-shadow:var(--ssm);border:1px solid var(--g100);padding:1.1rem 1.2rem;margin-bottom:1.75rem}
.chart-stats{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:.9rem}
.cstat{flex:1;min-width:80px;background:var(--g50);border-radius:var(--rmd);padding:.5rem .8rem;border:1px solid var(--g100);text-align:center}
.cstat-val{font-family:'Sora',sans-serif;font-size:16px;font-weight:700;line-height:1;margin-bottom:2px}
.cstat-lbl{font-size:10px;color:var(--g400);text-transform:uppercase;letter-spacing:.04em}
.chart-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:.9rem;flex-wrap:wrap;gap:8px}
.chart-title{font-family:'Sora',sans-serif;font-size:13px;font-weight:600;color:var(--g900)}
.chart-legend{display:flex;gap:12px;flex-wrap:wrap}
.leg{display:flex;align-items:center;gap:4px;font-size:11px;color:var(--g400)}
.leg-dot{width:9px;height:9px;border-radius:2px;flex-shrink:0}
.chart-wrap{position:relative}

/* PRAZOS */
.prazos-card{background:var(--wh);border-radius:var(--rlg);box-shadow:var(--ssm);border:1px solid var(--g100);overflow:hidden;margin-bottom:1.75rem}
.prazos-head{padding:.8rem 1.2rem;background:var(--dk);display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.prazos-head svg{width:14px;height:14px;stroke:rgba(255,255,255,.65)}
.prazos-head-title{font-family:'Sora',sans-serif;font-size:13px;font-weight:600;color:#fff}
.prazos-body{padding:.9rem 1.2rem;overflow-x:auto}
.th-sort{cursor:pointer;user-select:none;white-space:nowrap}
.th-sort:hover{color:var(--cy)!important}
.sort-icon{font-size:10px;opacity:.6;margin-left:2px}
.sort-icon.active{opacity:1;color:var(--cy)}
.alert{margin:0 1.2rem 1rem;background:var(--abg);border:1px solid #FBBF24;border-radius:var(--rmd);padding:.65rem .9rem;font-size:12px;color:var(--atx);display:flex;align-items:flex-start;gap:7px}
.alert svg{width:13px;height:13px;stroke:#D97706;flex-shrink:0;margin-top:1px}

/* SHARE */
.share-overlay{display:none;position:fixed;inset:0;background:rgba(10,20,40,.55);z-index:999;align-items:center;justify-content:center}
.share-overlay.open{display:flex}
.share-modal{background:var(--wh);border-radius:var(--rlg);box-shadow:0 20px 60px rgba(14,42,85,.25);padding:1.75rem 2rem;width:440px;max-width:95vw}
.share-modal-title{font-family:'Sora',sans-serif;font-size:16px;font-weight:600;color:var(--dk);margin:0 0 4px}
.share-modal-sub{font-size:12px;color:var(--g400);margin:0 0 1.25rem}
.share-options{display:flex;flex-direction:column;gap:10px}
.share-opt{display:flex;align-items:center;gap:12px;padding:.75rem 1rem;border-radius:var(--rmd);border:1px solid var(--g200);cursor:pointer;transition:all .15s;background:var(--wh);font-family:'DM Sans',sans-serif;text-align:left;width:100%}
.share-opt:hover{border-color:var(--cy);background:#F0FBFE}
.share-opt-icon{width:36px;height:36px;border-radius:var(--rmd);display:flex;align-items:center;justify-content:center;flex-shrink:0}
.share-opt-icon svg{width:18px;height:18px}
.share-opt-label{font-size:13px;font-weight:500;color:var(--g900)}
.share-opt-desc{font-size:11px;color:var(--g400);margin-top:1px}
.share-close{margin-top:1rem;width:100%;padding:8px;font-family:'DM Sans',sans-serif;font-size:13px;color:var(--g400);background:transparent;border:1px solid var(--g200);border-radius:var(--rmd);cursor:pointer}
.share-close:hover{background:var(--g100)}
.share-toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%);background:var(--dk);color:#fff;font-size:13px;font-weight:500;padding:10px 22px;border-radius:99px;z-index:9999;opacity:0;transition:opacity .3s;pointer-events:none}
.share-toast.show{opacity:1}

.pill-row{display:flex;gap:5px;margin-bottom:6px;flex-wrap:wrap}
.pill-sm{font-size:10px;font-weight:600;padding:2px 9px;border-radius:99px;white-space:nowrap;display:inline-block}
.pill-ok{background:#EAF3DE;color:#1A6E3A}
.pill-bad{background:#FDECEA;color:#B52B2B}
.stat-row{display:flex;justify-content:space-between;align-items:center;font-size:11px;padding:3px 0;border-bottom:1px solid var(--g100)}
.stat-row:last-child{border-bottom:none}
.stat-row .sk{color:var(--g400)}
.stat-row .sv{font-weight:600;color:var(--g900)}
.chart2-card{background:var(--wh);border-radius:var(--rlg);box-shadow:var(--ssm);border:1px solid var(--g100);padding:1.1rem 1.2rem;margin-bottom:1.75rem}
.rank-card{background:var(--wh);border-radius:var(--rlg);box-shadow:var(--ssm);border:1px solid var(--g100);padding:1.1rem 1.2rem;margin-bottom:1.75rem}
.rank-row{display:flex;align-items:center;gap:10px;padding:7px 0;border-bottom:1px solid var(--g100)}
.rank-row:last-child{border-bottom:none}
.rank-pos{font-family:'Sora',sans-serif;font-size:12px;font-weight:700;color:var(--g400);width:22px;text-align:center;flex-shrink:0}
.rank-pos.gold{color:#D97706}.rank-pos.silver{color:#6B7280}.rank-pos.bronze{color:#92400E}
.rank-name{font-size:12px;font-weight:500;color:var(--g700);flex:1;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.rank-reg{font-size:10px;font-weight:600;padding:1px 6px;border-radius:99px;flex-shrink:0}
.rank-reg.BA{background:#FEF3E2;color:#9B5C0A}
.rank-reg.RJ{background:#E3F2FD;color:#0D5FA0}
.rank-reg.DF{background:#EAF3DE;color:#1A6E3A}
.rank-bar-wrap{width:120px;flex-shrink:0}
.rank-bar-bg{background:var(--g100);border-radius:99px;height:6px;overflow:hidden}
.rank-bar-fill{height:100%;border-radius:99px;background:var(--opty-mid);transition:width .6s}
.rank-count{font-family:'Sora',sans-serif;font-size:12px;font-weight:700;color:var(--g900);width:36px;text-align:right;flex-shrink:0}
.rank-pend{font-size:10px;color:var(--atx);background:var(--abg);padding:1px 6px;border-radius:99px;flex-shrink:0;white-space:nowrap}
footer{text-align:center;font-size:11px;color:var(--g400);padding:1.25rem 0 2rem;border-top:1px solid var(--g200);margin-top:1rem}
@keyframes fadeUp{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:translateY(0)}}
.mc{animation:fadeUp .4s ease both}
.mc:nth-child(1){animation-delay:.04s}.mc:nth-child(2){animation-delay:.08s}
.mc:nth-child(3){animation-delay:.12s}.mc:nth-child(4){animation-delay:.16s}
.mc:nth-child(5){animation-delay:.20s}.mc:nth-child(6){animation-delay:.24s}
.mc:nth-child(7){animation-delay:.28s}
@media(max-width:900px){
  .metrics{grid-template-columns:repeat(4,1fr)}
  .page{padding:1rem .9rem 2rem}
  .topbar{padding:0 1rem}
}
</style>
</head>
<body>
<header class="topbar">
  <div class="tb-brand">
    <img src="data:image/png;base64," style="height:38px;width:auto" alt="Opty">
    <div class="tb-sep">
      <span class="tb-title">Dashboard SLA</span>
      <span class="tb-sub">Solicitações</span>
    </div>
  </div>
  <div class="tb-chips">
    <div class="chip cy" id="todayChip">—</div>
    <div class="chip">Prazo: 3 dias úteis</div>
    <div class="chip cy" id="dataChip" style="display:block">📊 2819 registros</div>
    <button class="share-btn" onclick="openShare()">
      <svg viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
      Compartilhar
    </button>
  </div>
</header>

<main class="page">
  <div id="dashboard">
    <!-- FILTERS -->
    <div class="filters-bar">
      <span class="fl">Filtros</span>
      <div style="display:flex;align-items:center;gap:6px"><label style="font-size:12px;color:var(--g400)">Convênio</label><select class="fs" id="fConv" onchange="applyFilters()"><option value="">Todos</option></select></div>
      <div style="display:flex;align-items:center;gap:6px"><label style="font-size:12px;color:var(--g400)">Tipo</label><select class="fs" id="fTipo" onchange="applyFilters()"><option value="">Todos</option><option value="Consulta">Consulta</option><option value="Exame">Exame</option></select></div>
      <div style="display:flex;align-items:center;gap:6px"><label style="font-size:12px;color:var(--g400)">Regional</label><select class="fs" id="fReg" onchange="applyFilters()"><option value="">Todas</option><option value="BA">BA</option><option value="RJ">RJ</option><option value="DF">DF</option></select></div>
      <div style="display:flex;align-items:center;gap:6px"><label style="font-size:12px;color:var(--g400)">Unidade</label><select class="fs" id="fUnidade" onchange="applyFilters()" style="max-width:220px"><option value="">Todas</option></select></div>
      <div style="display:flex;align-items:center;gap:6px;flex-wrap:wrap">
        <label style="font-size:12px;color:var(--g400)">Abertura</label>
        <input type="date" class="fd" id="fDe" onchange="applyFilters()">
        <span class="fsep">–</span>
        <input type="date" class="fd" id="fAte" onchange="applyFilters()">
      </div>
      <div style="display:flex;align-items:center;gap:6px;flex-wrap:wrap">
        <label style="font-size:12px;color:var(--g400)">Tratamento</label>
        <input type="date" class="fd" id="fTratDe" onchange="applyFilters()">
        <span class="fsep">–</span>
        <input type="date" class="fd" id="fTratAte" onchange="applyFilters()">
      </div>
      <div style="display:flex;align-items:center;gap:6px"><label style="font-size:12px;color:var(--g400)">Classificação</label>
        <select class="fs" id="fClass" onchange="applyFilters()">
          <option value="">Todas</option>
          <option value="Tratado dentro do prazo">Tratado dentro prazo</option>
          <option value="Tratado fora do prazo">Tratado fora prazo</option>
          <option value="Em atendimento - dentro do prazo">Em atend. – dentro</option>
          <option value="Em atendimento - fora do prazo">Em atend. – fora</option>
          <option value="Em aberto - dentro do prazo">Em aberto – dentro</option>
          <option value="Em aberto - fora do prazo">Em aberto – fora</option>
        </select>
      </div>
      <button class="btn-reset" onclick="resetFilters()">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" style="width:11px;height:11px"><path d="M2 8a6 6 0 106-.5"/><path d="M2 4v4h4"/></svg>Limpar
      </button>
      <span class="rc" id="resultsCount"></span>
    </div>

    <!-- METRICS -->
    <p class="sec">Visão geral</p>
    <div class="metrics">
      <div class="mc total">
        <div class="mc-icon"><svg viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/></svg></div>
        <div class="mc-val" id="mTotal">0</div><div class="mc-lbl">Total solicitações</div>
        <div class="mc-sub" id="mTotalSub">—</div>
