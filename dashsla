function renderRanking(top, order){
  if(top!==undefined) __rankTop=parseInt(top);
  if(order!==undefined) __rankOrder=order;

  // Agrupar por unidade
  const map={};
  filteredRows.forEach(r=>{
    if(!r.unidade) return;
    if(!map[r.unidade]) map[r.unidade]={nome:r.unidade, reg:r.reg, total:0, trat:0, pend:0, dentro:0, fora:0};
    map[r.unidade].total++;
    const isTrat = r.classif==='Tratado dentro do prazo'||r.classif==='Tratado fora do prazo';
    if(isTrat) map[r.unidade].trat++;
    else       map[r.unidade].pend++;
    if(r.classif==='Tratado dentro do prazo') map[r.unidade].dentro++;
    if(r.classif==='Tratado fora do prazo')   map[r.unidade].fora++;
  });

  let entries=Object.values(map);
  // Ordenar
  if(__rankOrder==='pend') entries.sort((a,b)=>b.pend-a.pend);
  else                     entries.sort((a,b)=>b.total-a.total);

  const maxVal = entries.length ? entries[0][__rankOrder==='pend'?'pend':'total'] : 1;
  const show = Math.min(__rankTop, entries.length);
  entries = entries.slice(0, show);

  const posClass = ['gold','silver','bronze'];
  const html2 = entries.map((u,i)=>{
    const pct = Math.round(u[__rankOrder==='pend'?'pend':'total']/maxVal*100);
    const pctTrat = u.total>0?Math.round(u.trat/u.total*100):0;
    const barColor = pctTrat>=80?'#22A85A':pctTrat>=50?'#EF9F27':'#E04444';
    return `<div class="rank-row">
      <span class="rank-pos ${posClass[i]||''}">${i+1}</span>
      <span class="rank-name" title="${u.nome}">${u.nome}</span>
      <span class="rank-reg ${u.reg}">${u.reg}</span>
      <div class="rank-bar-wrap">
        <div class="rank-bar-bg"><div class="rank-bar-fill" style="width:${pct}%;background:${barColor}"></div></div>
