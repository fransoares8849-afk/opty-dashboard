      <span class="rank-count">${__rankOrder==='pend'?u.pend:u.total}</span>
      ${u.pend>0?`<span class="rank-pend">⏳ ${u.pend} pend.</span>`:'<span style="font-size:10px;color:var(--gtx);background:var(--gbg);padding:1px 6px;border-radius:99px">✓ ok</span>'}
    </div>`;
  }).join('');

  const el=document.getElementById('rankingList');
  if(el) el.innerHTML=html2||'<p style="text-align:center;padding:1rem;color:var(--g400)">Nenhuma unidade no filtro atual</p>';
}

