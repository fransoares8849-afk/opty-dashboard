<script>
const TODAY = new Date(); TODAY.setHours(0,0,0,0);
let allRows=[], filteredRows=[];
let barChart=null;
let barChart2=null;
let __rankTop=10; let __rankOrder='total';
const COLORS=['#0E2A55','#1A5F9E','#2B9ED4','#2BB8D4','#3B82C4','#1E4A8C','#0D6E8E','#5B21B6'];

function bDays(s,e){if(!s||!e)return null;let d=0,c=new Date(s);while(c<e){c.setDate(c.getDate()+1);if(c.getDay()!==0&&c.getDay()!==6)d++;}return d;}
function addBiz(s,n){let d=new Date(s),c=0;while(c<n){d.setDate(d.getDate()+1);if(d.getDay()!==0&&d.getDay()!==6)c++;}return d;}
function fmtD(d){if(!d)return'—';return d.toLocaleDateString('pt-BR',{day:'2-digit',month:'2-digit',year:'numeric'});}
function cnt(rows,fn){return rows.filter(fn).length;}
function pillH(v,t){if(!v)return'<span class="pill p-gray">—</span>';const m={ok:'p-ok',warn:'p-warn',blue:'p-blue',red:'p-red',gray:'p-gray',purple:'p-purple'};return`<span class="pill ${m[t]||'p-gray'}">${v}</span>`;}

document.addEventListener('DOMContentLoaded',()=>{
  const fmt=d=>d.toLocaleDateString('pt-BR',{day:'2-digit',month:'long',year:'numeric'});
  document.getElementById('todayChip').textContent=fmt(TODAY);
  document.getElementById('footerDate').textContent='Atualizado em '+fmt(TODAY);
});

function initDashboard(data){
  window.__DASH_DATA__ = data;
  // Restaurar datas
  data.rows.forEach(r=>{
    r.dataAb  = r.dataAb  ? new Date(r.dataAb)  : null;
    r.dataAlt = r.dataAlt ? new Date(r.dataAlt)  : null;
    r.prazo   = r.prazo   ? new Date(r.prazo)    : null;
  });
  allRows = data.rows;
  filteredRows = allRows.slice();

  // Topbar data chip
  if(data.updatedAt){
    const d=new Date(data.updatedAt);
    const chip=document.getElementById('dataChip');
    chip.style.display='block';
    chip.textContent='📊 '+allRows.length+' registros';
    document.getElementById('footerDate').textContent='Atualizado em '+d.toLocaleDateString('pt-BR');
  }

  buildConvFilter();
  populateDates();
  renderAll();
}

function buildConvFilter(){
  const convs=[...new Set(allRows.map(r=>r.conv))].sort();
  const sel=document.getElementById('fConv');
  const curConv=sel.value;
  sel.innerHTML='<option value="">Todos</option>';
  convs.forEach(c=>{const o=document.createElement('option');o.value=c;o.textContent=c;sel.appendChild(o);});
  if(curConv) sel.value=curConv;

  // Popular filtro de unidade
  const selU=document.getElementById('fUnidade');
  if(selU){
    const curU=selU.value;
    // Filtrar unidades pelo regional e convênio selecionados se houver
    const regF=document.getElementById('fReg').value;
    const convF=document.getElementById('fConv').value;
    const baseRows=allRows.filter(r=>{
      if(regF&&r.reg!==regF) return false;
      if(convF&&r.conv!==convF) return false;
      return true;
    });
    const unids=[...new Set(baseRows.map(r=>r.unidade).filter(Boolean))].sort();
    selU.innerHTML='<option value="">Todas</option>';
    unids.forEach(u=>{const o=document.createElement('option');o.value=u;o.textContent=u+' ('+baseRows.filter(r=>r.unidade===u).length+')';selU.appendChild(o);});
    if(curU) selU.value=curU;
  }
}

function populateDates(){
  const dates=allRows.map(r=>r.dataAb).filter(Boolean).sort((a,b)=>a-b);
  if(!dates.length)return;
  // Só preenche se estiver vazio (não sobrescrever filtro manual)
  if(!document.getElementById('fDe').value)
    document.getElementById('fDe').value=dates[0].toISOString().slice(0,10);
  if(!document.getElementById('fAte').value)
    document.getElementById('fAte').value=dates[dates.length-1].toISOString().slice(0,10);
}

function applyFilters(){
  const conv=document.getElementById('fConv').value;
  const tipo=document.getElementById('fTipo').value;
  const reg =document.getElementById('fReg').value;
  const cls =document.getElementById('fClass').value;
  const unid=document.getElementById('fUnidade')?document.getElementById('fUnidade').value:'';
  // Datas de abertura
  const de  =document.getElementById('fDe').value  ?new Date(document.getElementById('fDe').value  +'T00:00:00'):null;
  const ate =document.getElementById('fAte').value ?new Date(document.getElementById('fAte').value +'T23:59:59'):null;
  // Datas de tratamento (data alteração status)
  const tratDeEl  = document.getElementById('fTratDe');
  const tratAteEl = document.getElementById('fTratAte');
  const tratDe  = tratDeEl  && tratDeEl.value  ? new Date(tratDeEl.value  +'T00:00:00') : null;
  const tratAte = tratAteEl && tratAteEl.value ? new Date(tratAteEl.value +'T23:59:59') : null;

  filteredRows=allRows.filter(r=>{
    if(conv&&r.conv!==conv)return false;
    if(tipo&&r.tipo!==tipo)return false;
    if(reg &&r.reg!==reg) return false;
    if(cls &&r.classif!==cls)return false;
    if(unid&&r.unidade!==unid)return false;
    // Filtro data abertura
    if(de  &&r.dataAb&&r.dataAb<de) return false;
    if(ate &&r.dataAb&&r.dataAb>ate)return false;
    // Filtro data tratamento
    if(tratDe||tratAte){
      if(!r.dataAlt) return false;
      if(tratDe  && r.dataAlt<tratDe)  return false;
      if(tratAte && r.dataAlt>tratAte) return false;
    }
    return true;
  });
  document.getElementById('resultsCount').textContent=filteredRows.length+' registros';
  buildConvFilter();
  renderAll();
}

function resetFilters(){
  ['fConv','fTipo','fReg','fClass','fTratDe','fTratAte'].forEach(id=>document.getElementById(id).value='');
  ['fDe','fAte'].forEach(id=>document.getElementById(id).value='');
  filteredRows=allRows.slice();
  populateDates();
  document.getElementById('resultsCount').textContent='';
  renderAll();
}

function renderAll(){renderMetrics();renderConv();renderRanking();renderChart();renderChart2();renderPrazos();}

function renderMetrics(){
  const rows=filteredRows, total=rows.length||1;
  const td=cnt(rows,r=>r.classif==='Tratado dentro do prazo');
  const tf=cnt(rows,r=>r.classif==='Tratado fora do prazo');
  const ad=cnt(rows,r=>r.classif==='Em aberto - dentro do prazo');
  const af=cnt(rows,r=>r.classif==='Em aberto - fora do prazo');
  const ead=cnt(rows,r=>r.classif==='Em atendimento - dentro do prazo');
  const eaf=cnt(rows,r=>r.classif==='Em atendimento - fora do prazo');
  const semAtend  = cnt(rows,r=>r.status==='Sem_atendimento');
  const emAtend   = cnt(rows,r=>r.status==='Em_atendimento');
  const pendCont  = cnt(rows,r=>r.status==='Pendente_contato');
  const pendAgend = cnt(rows,r=>r.status==='Pendente_agenda');
  const pendDoc   = cnt(rows,r=>r.status==='Pendente_documentação');
  const trat=td+tf;
  const pend=rows.length-trat;
  const pendDentro=ad+ead;
  const pendFora=af+eaf;
  const totalAtendPend=emAtend+pendCont+pendAgend+pendDoc;
  const pct=Math.round(trat/total*100);
  const pc=pct>=80?'#22A85A':pct>=50?'#EF9F27':'#E04444';
  const ba=cnt(rows,r=>r.reg==='BA'),rj=cnt(rows,r=>r.reg==='RJ'),df=cnt(rows,r=>r.reg==='DF');

  // Card 1 — Total
  document.getElementById('mTotal').textContent=rows.length;
  document.getElementById('mTotalSub').innerHTML=
    `<div class="stat-row"><span class="sk">BA</span><span class="sv">${ba}</span></div>`+
    `<div class="stat-row"><span class="sk">RJ</span><span class="sv">${rj}</span></div>`+
    `<div class="stat-row"><span class="sk">DF</span><span class="sv">${df}</span></div>`;
  document.getElementById('mTotalPct').textContent=pct+'%';
  document.getElementById('mTotalBar').style.cssText=`width:${pct}%;background:${pc}`;

  // Card 2 — Tratados
  document.getElementById('mTratado').textContent=trat;
  document.getElementById('mTratadoSub').innerHTML=
    `<div class="pill-row"><span class="pill-sm pill-ok">Dentro: ${td}</span><span class="pill-sm pill-bad">Fora: ${tf}</span></div>`;
  document.getElementById('mTratadoPctLbl').textContent=pct+'% do total';
  document.getElementById('mTratadoBar').style.width=pct+'%';

  // Card 3 — Pendentes
  document.getElementById('mPendente').textContent=pend;
  {
    let h=`<div class="pill-row"><span class="pill-sm pill-ok">No prazo: ${pendDentro}</span><span class="pill-sm pill-bad">Vencido: ${pendFora}</span></div>`;
    if(semAtend)  h+=`<div class="stat-row"><span class="sk">Sem atendimento</span><span class="sv">${semAtend}</span></div>`;
    if(emAtend)   h+=`<div class="stat-row"><span class="sk">Em atendimento</span><span class="sv">${emAtend}</span></div>`;
    if(pendCont)  h+=`<div class="stat-row"><span class="sk">Pend. contato</span><span class="sv">${pendCont}</span></div>`;
    if(pendAgend) h+=`<div class="stat-row"><span class="sk">Pend. agenda</span><span class="sv">${pendAgend}</span></div>`;
    if(pendDoc)   h+=`<div class="stat-row"><span class="sk">Pend. doc.</span><span class="sv">${pendDoc}</span></div>`;
    document.getElementById('mPendenteSub').innerHTML=h;
  }

  // Card 4 — Sem atendimento
  document.getElementById('mAberto').textContent=semAtend;
  document.getElementById('mAbertoSub').innerHTML=
    `<div class="stat-row"><span class="sk">No prazo</span><span class="sv" style="color:#1A6E3A">${ad}</span></div>`+
    `<div class="stat-row"><span class="sk">Vencido</span><span class="sv" style="color:#B52B2B">${af}</span></div>`;

  // Card 5 — Em atend./Pendentes
  document.getElementById('mAndamento').textContent=totalAtendPend;
  {
    let h='';
    if(emAtend)   h+=`<div class="stat-row"><span class="sk">Em atendimento</span><span class="sv">${emAtend}</span></div>`;
    if(pendCont)  h+=`<div class="stat-row"><span class="sk">Pend. contato</span><span class="sv">${pendCont}</span></div>`;
    if(pendAgend) h+=`<div class="stat-row"><span class="sk">Pend. agenda</span><span class="sv">${pendAgend}</span></div>`;
    if(pendDoc)   h+=`<div class="stat-row"><span class="sk">Pend. doc.</span><span class="sv">${pendDoc}</span></div>`;
    document.getElementById('mAndamentoSub').innerHTML=h||'—';
  }

  // Card 6 — Fora do prazo
  document.getElementById('mFora').textContent=tf+af+eaf;
  document.getElementById('mForaSub').innerHTML=
    `<div class="stat-row"><span class="sk">Tratados fora</span><span class="sv">${tf}</span></div>`+
    `<div class="stat-row"><span class="sk">Abertos vencidos</span><span class="sv">${af+eaf}</span></div>`;

  // Card 7 — Duplicados
  const regFiltro=document.getElementById('fReg')?document.getElementById('fReg').value:'';
  const convFiltro=document.getElementById('fConv')?document.getElementById('fConv').value:'';
  const dd=window.__DASH_DATA__||{};
  const dupsByReg=dd.dupsByReg||{BA:778,RJ:175,DF:210};
  const brutoByReg=dd.brutoByReg||{BA:1913,RJ:685,DF:1175};
  const unicosByReg=dd.unicosByReg||{BA:1135,RJ:510,DF:965};
  const dupsByConv=dd.dupsByConv||{};
  const brutoByConv=dd.brutoByConv||{};
  const unicosByConv=dd.unicosByConv||{};
  let dupVal, dupHtml;
  if(convFiltro&&dupsByConv[convFiltro]!==undefined){
    dupVal=dupsByConv[convFiltro];
